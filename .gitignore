# Elektron firmware derived files - never commit binaries (elekloader policy)
*.syx
*.bin
*.elemod
*.map.json
*.o
*.elf

# Python / build
__pycache__/
*.pyc
.venv/
.uv/
.venv*/
*.egg-info/

# digiemu - huge snapshots, logs, local venvs, nested clones stay local
tools/digiemu/portable/
tools/digiemu/.venv/
tools/digiemu/logs/
tools/digiemu/*.log
tools/elekloader/.venv/
tools/elekloader/out/
**/out/*.elemod
**/*.work/

# OS / editor
.DS_Store
Thumbs.db
*.tmp
*.bak

# Keep manifests and docs (negations must come after ignores, but *.syx is fully ignored)
# Stock OS reference stays documented by hash in docs/REPO.md, file itself stays local
# Only *.map.json is ignored above: release .syx.json manifests match NO ignore
# pattern, so they stay tracked in git. Do not add *.syx.json (or *.json) here.
